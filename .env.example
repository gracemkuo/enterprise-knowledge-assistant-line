# LINE Messaging API
LINE_CHANNEL_SECRET=replace-with-your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-your-channel-access-token

# Comma-separated LINE user IDs. Keep this explicit for the POC.
LINE_ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Agent Search (formerly Vertex AI Search / AI Applications)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_ENGINE_ID=your-agent-search-app-id
ANSWER_LANGUAGE_CODE=zh-TW

# LINE text messages support up to 5,000 characters. Leave room for sources.
MAX_LINE_MESSAGE_CHARS=4500

