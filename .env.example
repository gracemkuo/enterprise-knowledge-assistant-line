# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Comma-separated LINE user IDs. Keep this explicit for the POC.
LINE_ALLOWED_USER_IDS=

# Google Agent Search — Cloud Storage data store
# The Cloud Storage bucket is connected to the data store in Google Cloud,
# so no Workspace account, Drive folder ID, or bucket name is needed here.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_ENGINE_ID=your-agent-search-app-id
ANSWER_LANGUAGE_CODE=zh-TW

# LINE text messages support up to 5,000 characters. Leave room for sources.
MAX_LINE_MESSAGE_CHARS=4500
