# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Comma-separated LINE user IDs. Keep this explicit for the POC.
LINE_ALLOWED_USER_IDS=

# Google Agent Search — Cloud Storage data store
# The Cloud Storage bucket is connected to the data store in Google Cloud,
# so no Workspace account, Drive folder ID, or bucket name is needed here.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_ENGINE_ID=your-agent-search-app-id
# Optional retrieval hint for short or first-person questions. Do not put
# confidential document content here.
AGENT_SEARCH_QUERY_CONTEXT=
ANSWER_LANGUAGE_CODE=zh-TW

# LINE text messages support up to 5,000 characters. Leave room for sources.
MAX_LINE_MESSAGE_CHARS=4500

# Meta WhatsApp Cloud API (optional until the WhatsApp channel is enabled)
# Use a long random verify token. The app secret and access token must stay in
# Secret Manager in a deployed environment.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=

# Comma-separated E.164 phone numbers. Spaces, hyphens, and leading + are okay.
WHATSAPP_ALLOWED_PHONE_NUMBERS=

# Pin the deployed integration to a supported Meta Graph API version.
WHATSAPP_GRAPH_API_VERSION=v26.0

# WhatsApp text messages support up to 4,096 characters.
MAX_WHATSAPP_MESSAGE_CHARS=4000
